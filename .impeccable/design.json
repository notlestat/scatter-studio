	"narrative": {
		"northStar": "Image into matter",
		"overview": "Scatter is a working image instrument. Pale mineral controls surround a charcoal field; the picture supplies the texture, depth and motion. Archivo gives the interface a direct, compact voice. The sulphur accent identifies selection and activity without colouring the whole shell.\n\nThis records the implemented system in `src/style.css`, `src/main.ts` and `src/engine.ts`, reviewed 26 October 2026. Corey delegated the original direction. The surface contract remains in `.impeccable/surfaces/index-html.md`; it governs this editor's composition rather than every future screen. The procedural studies are original demonstrations, not user photographs.",
		"keyCharacteristics": [
			"Tonal groups and fine rules around an open artwork field.",
			"Compact, labelled controls with visible values and keyboard focus.",
			"Artwork motion driven by the rendering engine; quiet interface state changes.",
			"The field stays visible while mobile controls scroll."
		],
		"rules": [
			{
				"name": "The Artwork Colour Rule",
				"body": "Picture colours, single ink and light impulses belong to the artwork. Keep the surrounding controls in the mineral palette.",
				"section": "colors"
			},
			{
				"name": "The Quiet Label Rule",
				"body": "Let weight and spacing group the controls. Labels name an action or parameter; they do not become decorative headlines.",
				"section": "typography"
			},
			{
				"name": "The Visible Result Rule",
				"body": "A person moving a control must be able to see its effect on the field. Preserve the sticky mobile preview and its scroll offsets when changing layout.",
				"section": "layout"
			}
		],
		"dos": [
			"Do preserve visible artwork feedback during control edits.",
			"Do use the mineral shell and reserve picture colour for the field and its colour controls.",
			"Do retain native input behaviour, visible focus and explicit pressed states.",
			"Do keep upload, export and embedding discoverable at mobile sizes."
		],
		"donts": [
			"Don't turn ordinary inspector sections into floating cards.",
			"Don't substitute decorative texture for actual picture geometry.",
			"Don't describe brightness relief, imported maps and estimated depth as the same source.",
			"Don't inherit tiny auxiliary text as a general-purpose body scale."
		]
	}
}
